{
    "name": "GarageFlow Backend",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "web",
    "workspaceFolder": "/workspace",
    "shutdownAction": "stopCompose",
    "forwardPorts": [8000],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ],
            "settings": {
              "python.analysis.diagnosticMode": "openFilesOnly",
              "python.analysis.exclude": ["**/node_modules", "**/__pycache__", "**/.venv", "**/venv", "**/staticfiles"]
            }
        }
    }
}